# Frontier Command Centre: environment variables
# The setup command in the README copies this to .env, which Docker and
# native development (npm run dev) both read.

# Claude API key: enter it in the Hub under Admin → Access & Keys (Claude API Key).
# Leave this blank. A value here is used only when nothing is saved there.
ANTHROPIC_AI_API_KEY=

# Encryption key for secrets stored in the DB (API keys, tokens)
# MUST be stable across container/server restarts or encrypted data becomes unreadable
# Filled in by the setup command in the README (production refuses this placeholder)
CCC_ENCRYPTION_KEY=change-me

# Set to true when accessing the Hub over HTTP (localhost, no HTTPS proxy)
# Remove or set to false when serving via HTTPS (Tailscale, Cloudflare, etc.)
CCC_INSECURE_COOKIES=true
# Plain-HTTP localhost only: production refuses CCC_INSECURE_COOKIES=true unless this is also true.
CCC_ALLOW_INSECURE_COOKIES=true

# The bearer token and the collector token, filled in by the setup command in the README.
# OTEL_ENDPOINT_SECRET is your bearer token:
# Claude Code and Claude Cowork send it as Authorization=Bearer <this value>. You do not
# need to copy it from here: Admin → Ingestion shows it, with the settings ready to copy.
OTEL_ENDPOINT_SECRET=
# CCC_COLLECTOR_TOKEN: the collector presents this to the Hub. The Hub refuses
# telemetry until it is set.
CCC_COLLECTOR_TOKEN=

# The collector address shown on Admin → Ingestion until an admin sets one there
# with Edit. Change it once you serve the collector over HTTPS for your
# organisation, for example https://otel.your-company.com.
# CCC_COLLECTOR_ADDRESS=http://localhost:4318

# Password for the bundled database, filled in by the setup command. The database
# keeps the password it was created with: to change it, start again with
# `docker compose down -v`, which deletes all data. Left blank, the Hub uses a
# fixed default, which suits a computer used only by you.
CCC_PG_PASSWORD=

# Database TLS is automatic: off for the bundled database, and on with the
# certificate verified for any other database. To override, set CCC_PG_SSL to
# disable, require or no-verify.
# CCC_PG_SSL=

# Sample data only: also show the demo FinOps Enterprise figures and the demo
# Dev Framework Alignment scores that the sample data switches on. Remove the
# leading # from both lines and restart the Hub. Never set these on an
# installation that holds real data.
# CCC_FINOPS_ALLOW_MOCK=1
# CCC_DX_ALLOW_MOCK=1

# Native development only (npm run dev). Docker Compose does not read these:
# it sets the database address in docker-compose.yml, and the Enterprise keys
# are entered in the Hub under Admin → Access & Keys.
# Point DATABASE_URL at a PostgreSQL you can reach from your machine.
DATABASE_URL=postgresql://ccc:ccc-local-dev@localhost:5432/ccc
ANTHROPIC_ADMIN_API_KEY=
ANTHROPIC_ANALYTICS_API_KEY=
# Scheduler polling interval in seconds (default: 60)
INGEST_INTERVAL_SECONDS=60
